<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:CityPrint.App.Controls">

  <!-- Avalonia's drawn window decorations paint the window title at the top-left, over our menu.
       Our title bar shows the file name itself. IsVisible is template-bound, so hide it with Opacity. -->
  <Style Selector=":is(Visual)#PART_TitleTextPanel">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <!-- Dock pane chrome: panes are fixed in place, so no dropdown menu, pin button or right-click menu. -->
  <Style Selector=":is(Visual)#PART_ToolMenuButton, :is(Visual)#PART_MenuButton, :is(Visual)#PART_ToolPinButton, :is(Visual)#PART_PinButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Text -->
  <Style Selector="TextBlock.header">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource App.Muted}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Margin" Value="0,12,0,4" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource App.Muted}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Window chrome -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource App.Bg0}" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
  </Style>
  <Style Selector="Menu.titlebar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Menu.titlebar > MenuItem">
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <!-- Flat icon buttons for toolbars and panel headers -->
  <Style Selector="Button.tool, ToggleButton.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Foreground" Value="{DynamicResource App.Muted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Bg3}" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
  </Style>
  <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource App.Accent}" />
  </Style>
  <Style Selector="ToggleButton.tool:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource App.Accent}" />
  </Style>
  <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.BorderStrong}" />
  </Style>

  <!-- Accent call-to-action button -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource App.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource App.OnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource App.OnAccent}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="TextBox, ComboBox, NumericUpDown">
    <Setter Property="CornerRadius" Value="5" />
  </Style>

  <Style Selector="Separator.vertical">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="Background" Value="{DynamicResource App.Border}" />
  </Style>

  <!-- Icons inside menu items use the menu's text colour -->
  <Style Selector="MenuItem c|Icon">
    <Setter Property="Size" Value="15" />
  </Style>

  <!-- Explorer tree rows -->
  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="2,0" />
  </Style>

  <!-- Swatch chips used in the layers panel and explorer -->
  <Style Selector="Border.swatch">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#30808080" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Status bar -->
  <Style Selector="Border.statusbar">
    <Setter Property="Background" Value="{DynamicResource App.Bg0}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="10,3" />
  </Style>
  <Style Selector="Border.statusbar TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource App.Muted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
